# jac — copy to .env and fill in. Never commit .env. Read by compose.yaml (`env_file: .env`).
# A bare `manage.py` does NOT load it. On a laptop, put `DEBUG=1` into backend/.env.local instead.
# Uncommented keys must be set in prod; commented ones show the default.

# ── Core ─────────────────────────────────────────────────────────────────────
# Off unless set: a forgotten variable can't put a public site in debug mode.
DEBUG=0
BASE_DOMAIN=example.com
# Health checks don't need an entry here: nginx answers them under BASE_DOMAIN.
# ALLOWED_HOSTS=.example.com
# FRONTEND_URL=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com,https://example.com,https://*.example.com
# Set by the image build (the RELEASE build arg), not here. Listed for the drift test.
# RELEASE=dev

# ── Secrets: generate fresh for prod, never reuse dev values ─────────────────
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# postgres://user:password@host:5432/name, with the password URL-encoded. Unset on a laptop means
# its own server over the socket (`createdb jac`). Production refuses to boot without it.
DATABASE_URL=

# ── Valkey / Redis: Channels layer, cache, Celery broker ─────────────────────
REDIS_URL=redis://valkey:6379/0

# ── Files ────────────────────────────────────────────────────────────────────
# Everything uploaded goes under one folder the backup can read.
MEDIA_ROOT=/files/media
PRIVATE_MEDIA_ROOT=/files/private
# Baked into the image by collectstatic.
# STATIC_ROOT=/app/staticfiles
# 1 = nginx streams private files (X-Accel-Redirect). Default: on when DEBUG is off.
# PRIVATE_MEDIA_ACCEL=1

# ── Security / logging ───────────────────────────────────────────────────────
# Raise to 31536000 once a week of prod has run clean.
# SECURE_HSTS_SECONDS=3600
# Default: INFO in prod, WARNING in dev.
# LOG_LEVEL=INFO

# ── LLM ──────────────────────────────────────────────────────────────────────
# The model server. Bare host: the adapter speaks Ollama's native API (/api/chat, /api/embed).
HIRSCHAI_URL=http://model-server:11434
# Sent as a bearer token, per process: web and worker may carry different keys for one server.
# HIRSCHAI_API_KEY=
# The workers' key, when it differs (compose maps it onto their HIRSCHAI_API_KEY).
# HIRSCHAI_WORKER_API_KEY=
# HIRSCHAI_MODEL=qwen3.5:9b
# HIRSCHAI_EMBED_MODEL=qwen3-embedding:0.6b
# LLM_TIMEOUT=300
# LLM_THINKING=0
# How long a queued job waits for a model server that is off or starting, in seconds.
# LLM_COMPUTE_WAIT_S=900
# A visitor is waiting: past this many seconds the portfolio keeps its standard selection.
# PORTFOLIO_RANK_TIMEOUT_S=8
# Lets the admin save an LLM row at a private address (LLMConfig.clean).
# LLM_URL_ALLOWLIST=
# LLM_URL_ALLOW_PRIVATE=0
# 1 = store prompt + response text in LLMRequestLog. Default: off in prod (metadata only).
# LLM_LOG_BODIES=0
# The housekeeping job drops log rows after this many days (the privacy page promises it).
# LLM_LOG_RETENTION_DAYS=90
# Unset = every run embeds the corpus per request (fine for one box).
# VECTOR_STORE=

# ── Rate limits ──────────────────────────────────────────────────────────────
# LLM_CHAT_RATE=20/min
# LLM_CHAT_DAILY_RATE=100/day
# PORTFOLIO_RATE=60/hour
# PORTFOLIO_RANK_RATE=6/hour
# PORTFOLIO_INTRO_RATE=6/hour
# Also the daily cap: auto-runs and batches count against it too.
# GENERATION_RATE=20/day
# The editor's AI tools + dossier rebuilds.
# AI_JOB_RATE=60/hour
# A page polling for its AI intro.
# PORTFOLIO_POLL_RATE=600/hour
# Anything that puts a file on disk, per account.
# UPLOAD_RATE=100/day

# ── Auth ─────────────────────────────────────────────────────────────────────
# The kill switch: 0 closes signup. Open by default (public-site posture).
# ACCOUNT_ALLOW_SIGNUPS=1

# ── Email (SMTP; the From address must be a real mailbox at the provider) ────
# EMAIL_HOST=smtp.strato.de
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@example.com

# ── Portfolio ────────────────────────────────────────────────────────────────
PORTFOLIO_OWNER_USERNAME=lukas
# RESERVED_SUBDOMAINS=app,api,www,admin,static,media,mail,ns,ns1,ns2
# PORTFOLIO_ORIGIN_TEMPLATE=https://{handle}.example.com
# Contact address printed on /legal/imprint/. Default: the operator account's email.
# LEGAL_CONTACT_EMAIL=

# ── Compose only: not read by the app ────────────────────────────────────────
# The image every service runs.
# JAC_IMAGE=jac:current
# Where nginx finds daphne, if not the `app` service.
# APP_UPSTREAM=app:8000
